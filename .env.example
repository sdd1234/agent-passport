# Demo is entirely local. No provider calls unless explicitly enabled in Playground.
APP_MODE=demo
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Local default: H2 encrypted memory content; Docker Compose: PostgreSQL.
# DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/passport
# DATABASE_USER=passport
DATABASE_PASSWORD=replace-with-a-random-password
# Generate: openssl rand -base64 32 (required in live mode / Compose)
MEMORY_ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# vector requires PostgreSQL+pgvector and OpenAI embedding configuration.
SEARCH_MODE=lexical
EMBEDDING_MODEL=
EVM_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
REGISTRY_ADDRESS=
# Set only for a testnet deployment; never put a production wallet key here.
# DEPLOYER_PRIVATE_KEY=

# Service deployment: use infra/compose.production.yml (forces service mode, TLS cookies).
# PASSPORT_DOMAIN=passport.example.com
SIGNUP_ENABLED=true
# Optional Stripe subscription adapter. Empty values disable checkout; no pretend payments.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Configurable development defaults, not final published commercial terms.
FREE_FOLDERS=20
FREE_ENTRIES=500
FREE_STORAGE_BYTES=10485760
FREE_SHARES=10
PRO_FOLDERS=1000
PRO_ENTRIES=50000
PRO_STORAGE_BYTES=1073741824
PRO_SHARES=1000
