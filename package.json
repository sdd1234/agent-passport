{
  "name": "agent-passport",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/mcp-server"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "npm run build -w apps/web && npm run build -w apps/mcp-server",
    "test:contracts": "node --test contracts/test/registry.test.mjs",
    "test:e2e": "playwright test",
    "contracts:deploy": "node contracts/deploy.mjs",
    "test": "bash scripts/test.sh",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "format": "prettier --write apps/web/src apps/mcp-server/index.ts scripts/*.mjs contracts/*.mjs",
    "agent:codex": "node scripts/agent-client.mjs codex",
    "agent:claude": "node scripts/agent-client.mjs claude",
    "verify:local": "bash scripts/verify-local.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "embedded-postgres": "16.14.0-beta.17",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "prettier": "^3.9.6",
    "solc": "0.8.30"
  }
}
